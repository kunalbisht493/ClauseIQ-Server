# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000
API_ORIGIN=http://localhost:5000
# Comma-separated list of allowed origins or single URL (No trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ==============================================================================
# DATABASE (MongoDB Atlas)
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority

# ==============================================================================
# AUTHENTICATION & SECURITY (JWT & Cookies)
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-secret-key-for-jwt-signing
JWT_EXPIRES_IN=7d
# Set to 'true' in production with HTTPS, 'false' for localhost development
COOKIE_SECURE=false

# ==============================================================================
# GOOGLE OAUTH 2.0 (Sign in with Google)
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local: http://localhost:5000/api/auth/google/callback
# For production: https://clauseiq-server.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# Option 1 (Recommended for Production/Render): Resend HTTP API (Port 443 HTTPS)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ClauseIQ <onboarding@resend.dev>

# Option 2 (Fallback / Local Testing): Gmail SMTP (Port 465 SSL)
GMAIL_USER=clauseiq7@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ==============================================================================
# AI & EMBEDDINGS (Google Gemini)
# ==============================================================================
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ==============================================================================
# LLM INFERENCE (Groq Cloud)
# ==============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# RERANKING SERVICE (Jina AI)
# ==============================================================================
JINA_API_KEY=jina_your_api_key_here
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# ==============================================================================
# VECTOR DATABASE (Qdrant Cloud)
# ==============================================================================
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=legal_document_chunks

# ==============================================================================
# RAG PIPELINE & FILE UPLOAD SETTINGS
# ==============================================================================
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# Chunks sent to the LLM per question. Fewer = shorter prompt = faster answer (was 10).
RAG_TOP_K=6
# NOTE: no reranker is wired into the code yet, so RAG_RERANK_TOP_K and JINA_* are currently unused.
RAG_RERANK_TOP_K=5
# Max prior risk flags appended to each Q&A prompt (highest score first)
RAG_MAX_KNOWN_RISKS=8
# Maximum upload file size in bytes (10485760 bytes = 10 MB)
UPLOAD_MAX_FILE_SIZE=10485760

# ==============================================================================
# LATENCY TUNING (all optional - unset keeps the defaults shown)
# ==============================================================================
# LLM call timeouts. A timeout rotates to the next model/provider instead of hanging.
LLM_TIMEOUT_MS=30000
LLM_QA_TIMEOUT_MS=25000
LLM_RISK_TIMEOUT_MS=60000

# Route Q&A to Groq first (typically much faster for short answers). Test answer quality first.
# QA_LLM_PROVIDER=groq

# Cap "thinking" tokens on Gemini models that support it (0 = off). Big speed-up on extraction tasks.
# If you also set a max-output cap, keep it generous: on some models thinking counts toward it.
# QA_THINKING_BUDGET=0
# RISK_THINKING_BUDGET=1024
# QA_MAX_OUTPUT_TOKENS=1500
# RISK_MAX_OUTPUT_TOKENS=8192

# Concurrent embedding batches (100 chunks per batch)
EMBED_CONCURRENCY=4

# Repeat-question cache (in-memory, per server instance)
QA_CACHE_MAX=500
QA_CACHE_TTL_MS=3600000

# OCR the whole file when at least this fraction of pages has no text layer (e.g. 0.3).
# Unset = only OCR when the entire PDF has no text.
# OCR_EMPTY_PAGE_RATIO=0.3

# A document stuck in processing/indexed longer than this is marked failed (ms)
STALE_PROCESSING_MS=600000
