# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000
API_ORIGIN=http://localhost:5000
# Comma-separated list of allowed origins or single URL (No trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ==============================================================================
# DATABASE (MongoDB Atlas)
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database>?retryWrites=true&w=majority

# ==============================================================================
# AUTHENTICATION & SECURITY (JWT & Cookies)
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-secret-key-for-jwt-signing
JWT_EXPIRES_IN=7d
# Set to 'true' in production with HTTPS, 'false' for localhost development
COOKIE_SECURE=false

# ==============================================================================
# GOOGLE OAUTH 2.0 (Sign in with Google)
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local: http://localhost:5000/api/auth/google/callback
# For production: https://clauseiq-server.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# Option 1 (Recommended for Production/Render): Resend HTTP API (Port 443 HTTPS)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ClauseIQ <onboarding@resend.dev>

# Option 2 (Fallback / Local Testing): Gmail SMTP (Port 465 SSL)
GMAIL_USER=clauseiq7@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ==============================================================================
# AI & EMBEDDINGS (Google Gemini)
# ==============================================================================
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ==============================================================================
# LLM INFERENCE (Groq Cloud)
# ==============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# RERANKING SERVICE (Jina AI)
# ==============================================================================
JINA_API_KEY=jina_your_api_key_here
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# ==============================================================================
# VECTOR DATABASE (Qdrant Cloud)
# ==============================================================================
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=legal_document_chunks

# ==============================================================================
# RAG PIPELINE & FILE UPLOAD SETTINGS
# ==============================================================================
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
# Maximum upload file size in bytes (10485760 bytes = 10 MB)
UPLOAD_MAX_FILE_SIZE=10485760
